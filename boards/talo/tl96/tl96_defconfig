# TL96F072v2 board-level defconfig
# 仅包含 STM32F072 硬件运行所必需的配置，与具体键盘配置无关。

# SoC 选择由 Kconfig.tl96 (select SOC_STM32F072XB) 和 Kconfig.defconfig 完成
# 时钟频率由 DTS rcc 节点 clock-frequency 派生

# ===== Flash / NVS 持久化 =====
CONFIG_FLASH=y
CONFIG_FLASH_MAP=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS=y
CONFIG_SETTINGS_NVS=y

# ===== STM32F072 内存限制（仅 16KB SRAM）=====
CONFIG_MAIN_STACK_SIZE=640
# ISR 栈默认 2048B，但 STM32F0 (Cortex-M0) 无硬件中断嵌套，
# 缩小 ISR 栈释放 RAM 给线程栈，避免栈越界破坏 USB 枚举
CONFIG_ISR_STACK_SIZE=1024
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=640

# ===== STM32 驱动 =====
CONFIG_PINCTRL=y
# 自定义 WS2812 GPIO STM32 驱动（Zephyr 4.1.0 内置驱动仅支持 NRF）
CONFIG_WS2812_GPIO_STM32=y

# ===== 电源管理 =====
# 禁用 PM 子系统，避免 STM32F0 上 "Undefined initialization levels used" 链接错误
CONFIG_PM=n

# ===== 外设 / 功能 =====
CONFIG_ZMK_EXT_POWER=n
CONFIG_ZMK_HID_INDICATORS=y
CONFIG_ZMK_HID_REPORT_TYPE_NKRO=y
CONFIG_ZMK_IDLE_TIMEOUT=0
CONFIG_ZMK_KSCAN_MATRIX_POLLING=y
CONFIG_ZMK_USB=y

# ===== LED 驱动 =====
# 使用自定义 led_controller 统一管理灯效和指示灯，避免双写入者闪烁
# 自定义 ws2812_gpio_stm32 驱动自带 Kconfig，无需 WS2812_STRIP
# CONFIG_ZMK_RGB_UNDERGLOW is not set
