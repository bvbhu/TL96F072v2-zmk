/dts-v1/;

#include <st/f0/stm32f072Xb.dtsi>
#include <st/f0/stm32f072c(8-b)tx-pinctrl.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>

/ {
    model = "TL96";
    compatible = "talo,tl96";

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,code-partition = &code_partition;
        zephyr,settings-partition = &storage_partition;

        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zmk,underglow = &led_strip;
    };

    leds {
        compatible = "gpio-leds";
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        row-gpios
            = <&gpioa 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpioa 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpioa 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&gpioa 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpioa 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpioa 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpioa 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpioa 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpioa 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpioa 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpioa 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <6>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14) RC(3,15)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15)
            RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,5) RC(5,7) RC(5,8) RC(5,10) RC(5,12) RC(5,13) RC(5,14) RC(5,15)
        >;
    };

    /*
     * WS2812 RGB LED 灯带
     * PB12 数据引脚，96 颗 LED
     */
    led_strip: ws2812 {
        compatible = "bvbhu,ws2812-gpio-stm32";
        chain-length = <96>;
        gpios = <&gpiob 12 GPIO_ACTIVE_HIGH>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
        reset-delay = <50>;
    };
};

&clk_hsi {
    status = "okay";
};

&clk_hsi48 {
    status = "okay";
};

&pll {
    status = "okay";
    prediv = <1>;
    mul = <6>;
    clocks = <&clk_hsi>;
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <DT_FREQ_M(48)>;
    ahb-prescaler = <1>;
    apb1-prescaler = <1>;
};

/*
 * USB:
 * PA11 / PA12 为固定功能引脚，
 * STM32F0 USB 使用 pinctrl 切换到 AF 模式。
 */
zephyr_udc0: &usb {
    status = "okay";
    pinctrl-0 = <&usb_dm_pa11 &usb_dp_pa12>;
    pinctrl-names = "default";

    /* 限制端点数量以降低 RAM 占用 */
    num-bidir-endpoints = <4>;
};

/*
 * STM32F072 使用 ROM DFU bootloader，
 * bootloader 位于系统存储区，不占用用户 Flash。
 *
 * Flash:
 *   0x00000 ~ 0x1BFFF : code      112 KiB
 *   0x1C000 ~ 0x1FFFF : storage    16 KiB
 */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        code_partition: partition@0 {
            label = "code";
            reg = <0x00000000 0x0001c000>;
            read-only;
        };

        storage_partition: partition@1c000 {
            label = "storage";
            reg = <0x0001c000 0x00004000>;
        };
    };
};